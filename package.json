{
  "name": "mediaservis",
  "version": "1.0.0",
  "description": "Servis mobilnih telefonov in tablic Nova Gorica. Popravilo telefonov, menjava baterij, zaslonov in več.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18 <=22"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "qwik build --server",
    "dev": "vite",
    "dev:ssr": "qwik dev",
    "preview": "vite preview",
    "start": "qwik dev",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
"dependencies": {
  "@builder.io/qwik": "^1.8.0",
  "@builder.io/qwik-city": "^1.8.0",
  "@fontsource-variable/inter": "^5.0.20",
  "tailwind-merge": "^2.5.2",
  "@tailwindcss/typography": "^0.5.10",
  "markdown-it": "^13.0.1"
},
  "devDependencies": {
    "vite": "^5.4.2",
    "typescript": "5.5.4",
    "tailwindcss": "3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6"
  }
}
